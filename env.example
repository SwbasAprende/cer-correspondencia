# ============================================================
# Variables de entorno — Sistema de Correspondencia CER
# Copia este archivo como .env y completa los valores
# NUNCA subas el archivo .env real a Git
# ============================================================

# Django
SECRET_KEY=django-insecure-cambia-esto-por-una-clave-segura-en-produccion
DEBUG=True
ALLOWED_HOSTS=*

# Email (Gmail con contraseña de aplicación)
# Obtener en: https://myaccount.google.com/apppasswords
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
