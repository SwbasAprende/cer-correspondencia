# ============================================================
# Variables de entorno — Sistema de Correspondencia CER
# Copia este archivo como .env y completa los valores
# NUNCA subas el archivo .env real a Git
# ============================================================

# ── Django ─────────────────────────────────────────────────────────────────
SECRET_KEY=django-insecure-cambia-esto-por-una-clave-segura-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de datos ──────────────────────────────────────────────────────────
# Por defecto usa SQLite en desarrollo (no necesita configuración)
# En producción (Render): se proporciona automáticamente o mediante DATABASE_URL
DATABASE_URL=

# ── Redis (opcional, para caché en producción) ──────────────────────────────
REDIS_URL=

# ── Sentry para monitoreo de errores (opcional) ─────────────────────────────
# Obtener DSN en https://sentry.io/
# Ejemplo: https://abc123*@sentry.io/123456
SENTRY_DSN=

# ── Email (Gmail con contraseña de aplicación) ───────────────────────────────
# Obtener en: https://myaccount.google.com/apppasswords
# En DEBUG=True se usará el backend de consola (no envía reales)
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=xxxx-xxxx-xxxx-xxxx
